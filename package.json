{
  "name": "kairos-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "test": "bun test",
    "test:backend": "bun test backend/tests",
    "test:contracts": "bun test tests",
    "dev:backend": "bun --watch backend/src/index.ts",
    "dev:frontend": "bun --cwd frontend dev",
    "build:backend": "bun build backend/src/index.ts --outdir backend/dist --target node",
    "build:frontend": "bun --cwd frontend build",
    "check:contracts": "cargo check"
  },
  "devDependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.0",
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  }
}
