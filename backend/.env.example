# Kairos backend secrets (gitignored — never commit)
# Compose RPC endpoints at runtime; never paste raw keys into tracked files.
HELIUS_API_KEY=replace-after-rotating-in-helius-dashboard

SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
RELAYER_KEYPAIR=replace-with-base58-encoded-64-byte-devnet-keypair
KAIROS_ROUTER_PROGRAM_ID=3jWJZPdDou1h8UrT871Qi573yqQkFYYW8Jqiug9Pne5w
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
KAIROS_DB_SCHEMA=public
PLATFORM_FEE_BPS=20
# Charged on each rebalance side; each policy rate is capped at 75 bps.
REBALANCE_FEE_BPS=10

# Optional live Pyth snapshots. Configure only mints backed by a known USD feed.
# Hermes requires a Pyth API key. Feed IDs are available in the Pyth feed directory.
PYTH_API_KEY=
PYTH_FEEDS_JSON={}
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
PYTH_POLL_MS=15000
PYTH_MAX_AGE_SEC=60
# The backend builds the fallback URL itself when HELIUS_API_KEY is set.

# Server-side Privy config (frontend only ever receives the App ID)
PRIVY_APP_ID=cmuivma9d00dl0dkwdd6j33as
PRIVY_APP_SECRET=rotate-in-privy-dashboard-then-paste-here

# Basket publication requires credentials and actor IDs for two distinct admins.
ADMIN_TOKEN=replace-with-admin-1-secret
ADMIN_ACTOR_ID=admin-1
ADMIN_APPROVER_TOKEN=replace-with-admin-2-secret
ADMIN_APPROVER_ID=admin-2
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
