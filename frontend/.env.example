# Kairos Frontend Devnet Configuration (template — NO real secrets here)
# Copy to .env and fill in. .env is gitignored; this file may be committed.

# Solana RPC (public devnet default; use Helius/QuickNode for production)
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# Backend API URL
VITE_API_URL=http://localhost:3001

# Privy Authentication App ID (public by design — safe client-side)
# NEVER put PRIVY_APP_SECRET in a VITE_ variable: Vite bundles it into the
# client and any build/commit leaks it. The secret lives only in backend/.env.
VITE_PRIVY_APP_ID=your-privy-app-id
